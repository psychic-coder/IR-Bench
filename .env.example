# Copy to .env (make env does this and fills APP_UID/APP_GID). Every value is optional;
# docker-compose.yml supplies the defaults shown here.

# ---- container user (must own ./data and ./results on Linux hosts) ----
APP_UID=1000
APP_GID=1000

# ---- ports ----
API_PORT=8000
UI_PORT=3000
QDRANT_PORT=6333

# ---- reproducibility / hardware ----
SEED=42
# auto | cpu | cuda
DEVICE=auto
# torch/FAISS intra-op threads; empty = library default
NUM_THREADS=
BATCH_SIZE=16
# cpu | cu121 (the GPU compose override sets cu121)
TORCH_VARIANT=cpu
IMAGE_TAG=cpu

# ---- data ----
# download datasets on first use
AUTO_DOWNLOAD=true
# keep .tgz archives after extraction
KEEP_ARCHIVES=false
# e.g. 300 -> fast smoke mode for the benchmark service
DATASET_SUBSET=
DISTRACTOR_DIR=/data/distractors
# URL overrides if an archive moves (defaults are the official locations):
OXFORD_IMAGES_URL=
OXFORD_GT_URL=
PARIS_IMAGES_1_URL=
PARIS_IMAGES_2_URL=
PARIS_GT_URL=
ROXFORD_GND_URL=
RPARIS_GND_URL=

# ---- benchmark ----
# full | fast | ci  (configs/<name>.yaml)
BENCH_CONFIG=full

# ---- api ----
API_CONFIG=api.yaml
# override configs/api.yaml dataset (oxford5k | paris6k | toy_a | toy_b)
API_DATASET=
# serve a seeded subset (faster first start)
API_DATASET_SUBSET=
CORS_ORIGINS=http://localhost:3000
MAX_UPLOAD_MB=10
CACHE_TTL_SECONDS=86400
REDIS_MAXMEMORY=512mb
LOG_LEVEL=INFO

# ---- ui ----
# empty = browser talks to the API through the UI's /api/backend proxy
NEXT_PUBLIC_API_URL=

# ---- load test ----
K6_MAX_VUS=10
K6_DURATION_SCALE=1
K6_COLD_RATIO=0.3
K6_BACKBONE=dinov2_vits14
K6_INDEX=hnsw
K6_P95_WARM_MS=1500
K6_P95_COLD_MS=4000
K6_MAX_ERROR_RATE=0.01
